# SPA support for Expo web build on Apache/cPanel.
# Rewrite requests for non-existing files/directories to index.html.

RewriteEngine On

# If the request is already for an existing file or directory, serve it directly.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Otherwise, serve the SPA entrypoint.
RewriteRule ^ index.html [L]
